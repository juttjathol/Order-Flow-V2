# Copy to .dev.vars for local dev; in production set these as Pages env secrets
# (Cloudflare dashboard → the Pages project → Settings → Environment variables).
# None of these files are committed — .dev.vars is in .gitignore.

# PREFERRED: hashed admin password. Generate:  node scripts/hash-pass.mjs 'your password'
ADMIN_PASSWORD_HASH=

# Legacy fallback (works, but a hash beats a plaintext secret):
ADMIN_PASSWORD=change-me-now

# Long random string used only to sign admin session tokens (never the password):
#   openssl rand -hex 32
ADMIN_SECRET=

LICENSE_DEFAULT_DAYS=365

# GitHub fine-grained PAT: THIS repo only, permission Releases: Read-only.
# Only needed while the repo is private. Public repo → leave unset entirely.
GITHUB_TOKEN=

# Cross-origin API access: comma-separated exact origins, or leave empty
# (recommended) so /api only answers same-origin requests.
ALLOWED_ORIGINS=

# Optional. When set, GET /api/cloud/?diag=1 requires Bearer or ?token=.
DIAG_TOKEN=

# Optional Ed25519 PKCS8 (base64). When set, license validate replies are signed.
# Generate: node scripts/gen-license-keys.mjs
# LICENSE_SIGNING_KEY=
