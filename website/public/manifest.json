{
  "name": "Order Flow — Shop POS",
  "short_name": "Order Flow",
  "description": "Offline-first POS. Main on your Wi-Fi. Stations, kitchen, stock, prints — now in the browser. Your data stays on your device.",
  "start_url": "/app/?source=pwa",
  "scope": "/app/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "theme_color": "#FAF7F2",
  "background_color": "#FAF7F2",
  "icons": [
    { "src": "/media/logo.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/media/logo.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "categories": ["business", "productivity"],
  "handle_links": "preferred",
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "shortcuts": [
    { "name": "Tables", "url": "/app/?action=tables", "description": "Open floor map" },
    { "name": "Kitchen", "url": "/app/?action=kitchen", "description": "Pass tickets" },
    { "name": "Backup", "url": "/app/?action=backup", "description": "Export / import" }
  ],
  "screenshots": []
}
